{
  "name": "wenyihao-cn",
  "main": "worker/entrypoint.js",
  "workers_dev": true,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "host": "localhost" },
  "vars": { "MUSIC_API_TRANSPORT": "socket", "MUSIC_BACKEND_MODE": "regional", "GAME_SITE_ORIGIN": "https://wenyihao.cn", "SITE_EDGE_ORIGINS": "https://rt.wenyihao.cn" },
  "services": [{ "binding": "MUSIC_BACKEND", "service": "wenyihao-cn-music" }],
  "routes": [
    { "pattern": "wenyihao.cn", "custom_domain": true },
    { "pattern": "rt.wenyihao.cn/*", "zone_name": "wenyihao.cn" }
  ],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/realtime/*", "/api/*", "/network/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }, { "name": "GUESTBOOK", "class_name": "Guestbook" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }, { "tag": "v2-guestbook", "new_sqlite_classes": ["Guestbook"] }]
}
